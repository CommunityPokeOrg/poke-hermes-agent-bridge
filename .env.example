# ---- Bridge ----
# Comma-separated API keys callers present as Bearer tokens.
# "name:key" entries tag the caller in logs and in Hermes session keys.
# Every key must be >= 16 chars. Generate one with: poke-hermes-bridge gen-key
BRIDGE_API_KEYS=poke:replace-me-with-a-long-random-key

# HMAC secret for the inbound /v1/webhooks/poke endpoint and (fallback) for
# signing outbound webhook callbacks.
# BRIDGE_WEBHOOK_SECRET=

# Public base URL of this bridge (docs / poke-link helper only).
# BRIDGE_PUBLIC_URL=https://bridge.example.com

# BRIDGE_HOST=0.0.0.0
# BRIDGE_PORT=8700
# BRIDGE_SYNC_TIMEOUT_SECONDS=120
# BRIDGE_MAX_TIMEOUT_SECONDS=600
# BRIDGE_MAX_PROMPT_CHARS=32000
# BRIDGE_MAX_CONCURRENT_TASKS=8
# BRIDGE_RATE_LIMIT_PER_MINUTE=60   # 0 disables
# BRIDGE_TASK_TTL_SECONDS=3600
# BRIDGE_MAX_EVENTS_PER_TASK=500
# BRIDGE_POLL_INTERVAL_SECONDS=5
# BRIDGE_ALLOW_INSECURE_CALLBACKS=false
# BRIDGE_LOG_LEVEL=INFO
# BRIDGE_LOG_PROMPTS=false
# BRIDGE_CORS_ORIGINS=

# ---- Hermes ----
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace-with-hermes-api-server-key   # >=16 chars, matches ~/.hermes/.env API_SERVER_KEY
# HERMES_TIMEOUT_SECONDS=120
# HERMES_VERIFY_TLS=true
# HERMES_MODEL=hermes-agent

# ---- Poke (outbound result delivery) ----
# V2 API key created in Poke Kitchen; enables {"type":"poke"} callbacks.
# POKE_API_KEY=
# POKE_INBOUND_URL=https://poke.com/api/v1/inbound/api-message
# POKE_MAX_MESSAGE_CHARS=8000
